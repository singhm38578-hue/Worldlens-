# Copy this file to android/keystore.properties (gitignored) before building a signed release.
# NEVER commit android/keystore.properties or any .jks / .keystore file to version control.
# Alternatively, supply WORLDLENS_KEYSTORE_PATH, WORLDLENS_KEYSTORE_PASSWORD,
# WORLDLENS_KEY_ALIAS, and WORLDLENS_KEY_PASSWORD as environment variables in CI.

storeFile=/absolute/path/to/worldlens-release.jks
storePassword=CHANGE_ME_STORE_PASSWORD
keyAlias=worldlens-release
keyPassword=CHANGE_ME_KEY_PASSWORD
